# Snowflake Connection Configuration
# Copy this file to .env and fill in real values. DO NOT commit .env.

# Snowflake account identifier (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=your_account_id

# Snowflake username
SNOWFLAKE_USER=your_user

# Snowflake password (if using password auth)
SNOWFLAKE_PASSWORD=your_password

# Snowflake private key path (alternative to password, for key-pair auth)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

# Snowflake warehouse name
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Snowflake database name
SNOWFLAKE_DATABASE=YOUR_DB

# Snowflake schema name
SNOWFLAKE_SCHEMA=YOUR_SCHEMA

# Snowflake role
SNOWFLAKE_ROLE=YOUR_ROLE

# Anthropic API key (for LLM-assisted checking). No spaces or quotes around the value.
ANTHROPIC_API_KEY=your_api_key
